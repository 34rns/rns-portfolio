{
  "$schema":"node_modules/wrangler/config-schema.json",
  "name":"rns-portfolio",
  "main":".open-next/worker.js",
  "compatibility_date":"2026-11-14",
  "compatibility_flags":["nodejs_compat","global_fetch_strictly_public"],
  "assets":{"directory":".open-next/assets","binding":"ASSETS"},
  "services":[{"binding":"WORKER_SELF_REFERENCE","service":"rns-portfolio"}],
  "r2_buckets":[{"binding":"NEXT_INC_CACHE_R2_BUCKET","bucket_name":"rns-portfolio-cache"},{"binding":"PORTFOLIO_UPLOADS","bucket_name":"rns-portfolio-uploads"}],
  "vars":{"KEYGATE_TRUSTED_PROXY":"cloudflare","CF_WORKER_CONTEXT":"true","STORAGE_PROVIDER":"r2","SITE_SETTINGS_DRIVER":"database"}
}
