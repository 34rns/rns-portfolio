# Postgres (Neon via Vercel Marketplace). Pull with: vercel env pull .env.local
DATABASE_URL="postgres://user:password@host/db?sslmode=require"

# Auth.js. Generate with: npx auth secret
AUTH_SECRET=""

# The single admin account. Hash with: npm run admin:hash -- "your-password"
ADMIN_EMAIL=""
ADMIN_PASSWORD_HASH="salt:hash"

# Canonical origin used for metadata, sitemap and OG images.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Phase 2 (do not set yet)
# PAYMENTS_PROVIDER=""
# POLAR_ACCESS_TOKEN=""
# POLAR_WEBHOOK_SECRET=""
# BLOB_READ_WRITE_TOKEN=""
