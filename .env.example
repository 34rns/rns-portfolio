# Postgres (Neon via Vercel Marketplace). Pull with: vercel env pull .env.local
DATABASE_URL="postgres://user:password@host/db?sslmode=require"

# Auth.js. Generate with: npx auth secret
AUTH_SECRET=""

# The single admin account. Hash with: npm run admin:hash -- "your-password"
ADMIN_EMAIL=""
ADMIN_PASSWORD_HASH="salt:hash"

# Canonical origin used for metadata, sitemap, OG images and checkout redirects.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Payments. One of: manual | mock | polar | lemonsqueezy.
# "manual" (the production default) sells Pro by hand: the paid project page
# shows a Request Pro form, you confirm payment yourself and send a license key.
# "mock" is refused in a production runtime (next start / Vercel, preview
# included) because it signs its own webhooks, and an unset value resolves to
# manual there rather than falling back to it.
PAYMENT_PROVIDER="manual"

# Mock provider only: signs the simulated webhook. No keys, no network.
# REQUIRED whenever the mock provider is selected - there is no default value,
# and without it the mock checkout and its webhook both refuse to run.
MOCK_PAYMENT_SECRET=""

# Polar (https://polar.sh). Use sandbox while testing.
POLAR_ACCESS_TOKEN=""
POLAR_WEBHOOK_SECRET=""
POLAR_SERVER="sandbox"

# Lemon Squeezy (https://lemonsqueezy.com).
LEMONSQUEEZY_API_KEY=""
LEMONSQUEEZY_STORE_ID=""
LEMONSQUEEZY_WEBHOOK_SECRET=""

# Uploads. Without a Blob token, files are written to ./uploads and served by
# /api/uploads; that only works on a local checkout.
BLOB_READ_WRITE_TOKEN=""
# Storage driver: "blob" or "local". Production and preview are pinned to
# "blob" on Vercel; if it is "blob" and BLOB_READ_WRITE_TOKEN is missing the
# upload endpoints return 503 instead of writing to disk. Unset = choose from
# token presence (what a plain local checkout wants).
STORAGE_PROVIDER=""
# Optional: override the local upload folder. Defaults to ./uploads.
# UPLOAD_DIR=""

# --- Licensing -------------------------------------------------------------
# Generate all of these with: node scripts/license-keys.mjs --write
# LICENSE_SECRET is the master key (32+ bytes). HKDF derives the HMAC key for
# lookup hashes and the AES-256-GCM key for values kept encrypted at rest, so
# changing it makes existing order links and license keys unreadable.
LICENSE_SECRET=""

# Ed25519 (PKCS#8 DER, base64) that signs the short-lived license tokens the
# apps verify offline. Rotate it by moving the current value to _PREVIOUS.
LICENSE_TOKEN_PRIVATE_KEY=""
LICENSE_TOKEN_PRIVATE_KEY_PREVIOUS=""

# Days an app may keep working on a cached token before it must re-verify.
LICENSE_GRACE_DAYS="7"
# Hours a freshly issued token stays valid.
LICENSE_TOKEN_TTL_HOURS="12"

# Origins allowed to call /api/license/* from a browser, comma separated.
# Exact matches only — include the chrome-extension:// origin if an extension
# calls the API. Desktop apps send no Origin and are always allowed.
# ALLOWED_ORIGINS="https://your-domain.example,chrome-extension://abcdefghijklmnop"
